---
import { site } from "../data/site";
import { url } from "../lib/url";

const nav = [
  { href: url("/#domenii"), label: "Domenii" },
  { href: url("/#despre"), label: "Despre" },
  { href: url("/#proces"), label: "Cum lucrăm" },
  { href: url("/#onorarii"), label: "Onorarii" },
  { href: url("/#articole"), label: "Articole" },
  { href: url("/#contact"), label: "Contact" },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <div class="wrap flex items-center justify-between" style="height: var(--header-h)">
    <a href={url("/")} class="group flex items-baseline gap-2.5" aria-label="Acasă">
      <span class="serif whitespace-nowrap text-[22px] tracking-[0.14em] text-paper">{site.wordmark}</span>
      <span class="hidden whitespace-nowrap text-[11px] uppercase tracking-[0.18em] text-muted 2xl:inline">
        cabinet de avocatură
      </span>
    </a>

    <nav class="hidden items-center gap-5 lg:flex xl:gap-7" aria-label="Navigare principală">
      {nav.map((n) => (
        <a
          href={n.href}
          class="relative whitespace-nowrap py-1 text-[14.5px] text-paper/80 transition-colors hover:text-paper after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-brass-400 after:transition-transform after:duration-200 hover:after:scale-x-100"
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3 lg:gap-4 lg:pl-8">
      <a
        href={site.phoneHref}
        class="hidden whitespace-nowrap text-[14.5px] tabular-nums text-paper/80 transition-colors hover:text-brass-300 md:block lg:hidden xl:block"
      >
        {site.phone}
      </a>
      <a
        href={url("/#contact")}
        class="hidden whitespace-nowrap rounded-[10px] bg-brass-500 px-5 py-2.5 text-[14px] font-medium text-ink-950 transition-colors hover:bg-brass-400 md:inline-block"
      >
        Programează<span class="hidden xl:inline"> o consultație</span>
      </a>

      <button
        type="button"
        id="menu-open"
        class="flex h-10 w-10 items-center justify-center text-paper lg:hidden"
        aria-label="Deschide meniul"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="relative block h-3.5 w-6">
          <span class="absolute inset-x-0 top-0 h-px bg-current"></span>
          <span class="absolute inset-x-0 top-1/2 h-px bg-current"></span>
          <span class="absolute inset-x-0 bottom-0 h-px bg-current"></span>
        </span>
      </button>
    </div>
  </div>
  <div id="header-rule" class="h-px w-full bg-paper/0 transition-colors duration-300"></div>
</header>

<!-- Meniu mobil -->
<div
  id="mobile-menu"
  class="invisible fixed inset-0 z-60 bg-ink-950 opacity-0 transition-[opacity,visibility] duration-250 lg:hidden"
>
  <div class="wrap flex items-center justify-between" style="height: var(--header-h)">
    <span class="serif whitespace-nowrap text-[22px] tracking-[0.14em]">{site.wordmark}</span>
    <button
      type="button"
      id="menu-close"
      class="flex h-10 w-10 items-center justify-center text-paper"
      aria-label="Închide meniul"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>

  <nav class="wrap mt-6 flex flex-col" aria-label="Navigare mobilă">
    {nav.map((n, i) => (
      <a
        href={n.href}
        class="rule serif flex items-baseline gap-4 py-4 text-[26px] text-paper"
        data-close-menu
      >
        <span class="w-6 font-sans text-[12px] tabular-nums text-brass-500">
          {String(i + 1).padStart(2, "0")}
        </span>
        {n.label}
      </a>
    ))}
  </nav>

  <div class="wrap mt-8 flex flex-col gap-3">
    <a
      href={url("/#contact")}
      data-close-menu
      class="rounded-[10px] bg-brass-500 px-5 py-3.5 text-center font-medium text-ink-950"
    >
      Programează o consultație
    </a>
    <a
      href={site.phoneHref}
      class="rounded-[10px] border border-paper/20 px-5 py-3.5 text-center text-paper"
    >
      Sună la {site.phone}
    </a>
  </div>
</div>

<script>
  const header = document.getElementById("site-header");
  const rule = document.getElementById("header-rule");
  const menu = document.getElementById("mobile-menu");
  const openBtn = document.getElementById("menu-open");
  const closeBtn = document.getElementById("menu-close");

  const onScroll = () => {
    const solid = window.scrollY > 24;
    header?.classList.toggle("bg-ink-950/95", solid);
    header?.classList.toggle("backdrop-blur-sm", solid);
    rule?.classList.toggle("bg-paper/10", solid);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    menu?.classList.toggle("invisible", !open);
    menu?.classList.toggle("opacity-0", !open);
    openBtn?.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
  };

  openBtn?.addEventListener("click", () => setMenu(true));
  closeBtn?.addEventListener("click", () => setMenu(false));
  menu?.querySelectorAll("[data-close-menu]").forEach((el) =>
    el.addEventListener("click", () => setMenu(false))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
